# Supabase project settings (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional server-only key for reliable Arabic translation in production.
# Never prefix this with NEXT_PUBLIC_ and never commit the real value.
GOOGLE_CLOUD_TRANSLATE_API_KEY=your-server-only-google-cloud-key

# Optional server-only Google service-account JSON for Chirp 3 HD word audio.
# Keep the complete JSON on one line in the hosted secret. Never expose it with
# a NEXT_PUBLIC_ prefix or commit the real credential.
GOOGLE_CLOUD_TTS_SERVICE_ACCOUNT_JSON={"type":"service_account","client_email":"tts@your-project.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","token_uri":"https://oauth2.googleapis.com/token"}

# Required before public launch. These appear in the legal pages.
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=Your legal name or registered business name
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=privacy@example.com
