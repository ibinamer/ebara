# Supabase project settings (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional server-only Azure Translator credentials for reliable Arabic
# dictionary meanings and definition translation in production. Never prefix
# either secret with NEXT_PUBLIC_ and never commit the real values.
AZURE_TRANSLATOR_KEY=your-server-only-azure-translator-key
AZURE_TRANSLATOR_REGION=your-azure-resource-region

# Required before public launch. These appear in the legal pages.
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=Your legal name or registered business name
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=privacy@example.com
