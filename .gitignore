# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# --- Secrets -----------------------------------------------------------------
# Every .env variant is ignored; only the placeholder template is committed.
# Nothing in this project needs a server-side secret, so anything matching here
# is almost certainly a real credential that must not be pushed.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets.json
credentials.json

# --- Dependencies ------------------------------------------------------------
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# --- Build output and caches -------------------------------------------------
/.next/
/.vinext/
/out/
/dist/
/.wrangler/
/outputs/
/work/
.turbo/
*.tsbuildinfo
next-env.d.ts

# --- Testing -----------------------------------------------------------------
/coverage

# --- Logs --------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- Editors -----------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo

# --- Operating system --------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini

# --- Hosting -----------------------------------------------------------------
.vercel
